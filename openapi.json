{
  "openapi": "3.1.0",
  "info": {
    "title": "Nescio Semantic Memory API",
    "description": "NescioAI semantic memory core.",
    "version": "0.6.0"
  },
  "paths": {
    "/api/v1/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Hybrid keyword and semantic search over passages",
        "description": "Hybrid search over note passages: a full-text arm (websearch_to_tsquery: phrases, words, exclusions) and a vector arm (semantic similarity), fused by reciprocal rank. Returns individual matching passages, never whole notes, ordered by the fused score. Always fills up to top_k when that many passages exist -- there is no relevance floor -- and fts_rank null marks a semantic-only match. A query with no usable keywords (stop words only) is answered by the vector arm. If the query cannot be embedded because the embedding backend is briefly unavailable, the response is full-text only and degraded is true.",
        "operationId": "searchPassages",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request was rejected. `detail` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "401": {
            "description": "The X-API-Key header is missing, unknown or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "413": {
            "description": "The request body is over the size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "500": {
            "description": "The embedding backend is misconfigured, or an unexpected error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable, or a query exceeded its time limit. Retry-After is sent only on the 503s where a retry can succeed; \"Query exceeded time limit\" sends none.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
