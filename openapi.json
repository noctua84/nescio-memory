            "title": "Provenance Date",
            "description": "Optional date associated with provenance."
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "Optional status label (e.g., 'approved', 'superseded').",
            "examples": [
              "approved"
            ]
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash",
            "description": "Hash of the note content, used to detect changes."
