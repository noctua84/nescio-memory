          "path_or_uri": {
            "type": "string",
            "title": "Path Or Uri",
            "description": "Unique path or URI of the note within its scope.",
            "examples": [
              "docs/architecture/adr-001.md"
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Optional human-readable name extracted from frontmatter.",
            "examples": [
              "ADR-001: Use PostgreSQL"
