{
  "openapi": "3.1.0",
  "info": {
    "title": "Nescio Semantic Memory API",
    "description": "NescioAI semantic memory core.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Semantic Memory Search",
        "description": "Queries pgvector using a natural language prompt.",
        "operationId": "search_memory_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest": {
      "post": {
        "tags": [
          "Ingest"
        ],
        "summary": "Ingest Markdown File",
        "description": "Chunks content, embeds via Ollama, and upserts into pgvector.",
        "operationId": "ingest_file_api_v1_ingest_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_file_api_v1_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_ingest_file_api_v1_ingest_post": {
        "properties": {
          "repo_name": {
            "type": "string",
            "title": "Repo Name",
            "description": "Repository this file belongs to."
          },
          "file_path": {
            "type": "string",
            "title": "File Path",
            "description": "Relative path of the file."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Raw markdown content to vectorize."
          }
        },
        "type": "object",
        "required": [
          "repo_name",
          "file_path",
          "content"
        ],
        "title": "Body_ingest_file_api_v1_ingest_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operation status.",
            "examples": [
              "success"
            ]
          },
          "file": {
            "type": "string",
            "title": "File",
            "description": "Path of the processed file."
          },
          "ingested": {
            "type": "integer",
            "title": "Ingested",
            "description": "Number of chunks stored."
          }
        },
        "type": "object",
        "required": [
          "status",
          "file",
          "ingested"
        ],
        "title": "IngestResponse"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "The natural language search query.",
            "examples": [
              "How do we handle API authentication across repos?"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 50,
            "minimum": 1,
            "title": "Top K",
            "description": "Max chunks to return.",
            "default": 5
          },
          "repo_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Filter",
            "description": "Optional filter by repository name.",
            "examples": [
              "repo_a"
            ]
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "SearchResponse"
      },
      "SearchResult": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The retrieved markdown chunk."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "File path, repo name, chunk index."
          },
          "similarity": {
            "type": "number",
            "title": "Similarity",
            "description": "Cosine similarity score (0-1)."
          }
        },
        "type": "object",
        "required": [
          "content",
          "metadata",
          "similarity"
        ],
        "title": "SearchResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}