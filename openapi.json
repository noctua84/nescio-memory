                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable, or a query exceeded its time limit. Retry-After is sent only on the 503s where a retry can succeed; \"Query exceeded time limit\" sends none.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such note for this client."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scopes": {
      "delete": {
        "tags": [
          "Notes"
        ],
        "summary": "Delete every note in a scope",
        "description": "Retire a whole scope: delete every note in it and, by cascade, their passages. An empty or omitted scope is refused with 400 unless root_scope=true is sent, in which case scope must be empty or omitted and the root (empty) scope is the one deleted. A scope with no notes is not an error: the response is 200 with zero counts.",
        "operationId": "deleteScope",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "description": "Scope to delete. Omit or leave empty only with root_scope=true.",
              "title": "Scope"
            },
            "description": "Scope to delete. Omit or leave empty only with root_scope=true."
          },
          {
            "name": "root_scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Must be true to delete the root (empty) scope; then scope must be empty or omitted.",
              "default": false,
              "title": "Root Scope"
            },
            "description": "Must be true to delete the root (empty) scope; then scope must be empty or omitted."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteNotesResponse"
                }
              }
            }
          },
          "400": {
            "description": "scope is empty or omitted without root_scope=true, or root_scope=true was combined with a non-empty scope."
          },
          "401": {
            "description": "The X-API-Key header is missing, unknown or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "413": {
            "description": "The request body is over the size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "500": {
            "description": "The embedding backend is misconfigured, or an unexpected error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable, or a query exceeded its time limit. Retry-After is sent only on the 503s where a retry can succeed; \"Query exceeded time limit\" sends none.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Readiness probe",
        "description": "Reports whether PostgreSQL and the embedding backend can serve, within a hard time bound. Unlike `/health` (liveness) this contacts the dependencies. 200 `ready` or 200 `degraded` (the embedding backend is down but the database works); 503 `not_ready` when the database is down. Alert when `status` is not `ready`; `checks.embedding_backend.status` names the failing dependency.",
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable (`not_ready`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fail",
              "timeout"
            ],
            "title": "Status",
            "description": "`ok`: a trivial query succeeded. `fail`: the database could not be reached or the query errored. `timeout`: no answer within READY_DB_TIMEOUT_S."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DatabaseCheck"
      },
      "DeleteNotesResponse": {
        "properties": {
          "notes_deleted": {
            "type": "integer",
            "title": "Notes Deleted",
            "description": "Number of notes removed."
          },
          "passages_deleted": {
            "type": "integer",
            "title": "Passages Deleted",
            "description": "Number of passages removed along with those notes."
          },
          "notes": {
            "items": {
              "$ref": "#/components/schemas/DeletedNote"
            },
            "type": "array",
            "title": "Notes",
            "description": "Every note removed, so a caller can reconcile its own index."
          }
        },
        "type": "object",
        "required": [
          "notes_deleted",
          "passages_deleted",
          "notes"
        ],
        "title": "DeleteNotesResponse",
        "description": "Result of deleting a note by path, or a whole scope."
      },
      "DeletedNote": {
        "properties": {
          "note_id": {
            "type": "integer",
            "title": "Note Id",
            "description": "Id the note had before it was deleted."
          },
          "path_or_uri": {
            "type": "string",
            "title": "Path Or Uri",
            "description": "Path or URI the note had within its scope.",
            "examples": [
              "docs/architecture/adr-001.md"
            ]
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash",
            "description": "Content hash the note had when it was deleted."
          }
        },
        "type": "object",
        "required": [
          "note_id",
          "path_or_uri",
          "content_hash"
        ],
        "title": "DeletedNote",
        "description": "Identity of one note a delete removed."
      },
      "EmbeddingBackendCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fail",
              "timeout",
              "not_checked"
            ],
            "title": "Status",
            "description": "`ok`: Ollama answered and the configured model is pulled. `fail`: unreachable, or the model is missing. `timeout`: no answer within READY_EMBEDDING_TIMEOUT_S. `not_checked`: the `local` backend runs in-process, so there is nothing remote to probe."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "EmbeddingBackendCheck"
      },
      "ErrorDetail": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Fixed message for the failure. Never an internal exception message."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "description": "Body of every error response from /api/v1, other than request validation."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "maxLength": 512,
            "title": "Scope",
            "description": "Scope to organize notes within a tenant. Accepts both 'scope' and 'repo_name' aliases for backwards compatibility.",
            "default": "",
            "examples": [
              "project-a",
              ""
            ]
          },
          "path_or_uri": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Path Or Uri",
            "description": "Unique path or URI of the note within its scope.",
            "examples": [
              "docs/architecture/adr-001.md"
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Full markdown content of the note."
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "Optional status label for the note (e.g., 'draft', 'approved', 'superseded').",
            "examples": [
              "approved"
            ]
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta",
            "description": "Optional metadata dictionary for the note."
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "description": "Re-split, re-embed and rewrite this note's passages even when the content hash and pipeline version both match. The escape hatch for a change the pipeline version cannot see -- most plausibly a re-pulled embedding model behind an unchanged backend name and dimension.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "path_or_uri",
          "content"
        ],
        "title": "IngestRequest",
        "description": "Request to ingest a note with passages."
      },
      "IngestResponse": {
        "properties": {
          "note_id": {
            "type": "integer",
            "title": "Note Id",
            "description": "ID of the ingested note."
          },
          "passages": {
            "type": "integer",
            "title": "Passages",
            "description": "Number of passages now stored for this note."
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped",
            "description": "True when the skip fired (content unchanged and force=False); always False under force."
          }
        },
        "type": "object",
        "required": [
          "note_id",
          "passages",
          "skipped"
        ],
        "title": "IngestResponse",
