      "ReadinessReport": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded",
              "not_ready"
            ],
            "title": "Status",
            "description": "`ready`: everything is fine. `degraded`: the database works but the embedding backend does not (HTTP 200, so replicas stay in rotation; alert on this field). `not_ready`: the database is down (HTTP 503)."
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessReport"
      },
      "SearchRequest": {
        "properties": {
          "q": {
            "type": "string",
