          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Optional summary from frontmatter. Used in search at FTS weight C."
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type",
            "description": "Optional type classification from frontmatter (e.g., 'adr', 'design-doc').",
            "examples": [
