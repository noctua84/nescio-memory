    "/api/v1/notes": {
      "delete": {
        "tags": [
          "Notes"
        ],
        "summary": "Delete a note by scope and path",
        "description": "Delete the note stored at (scope, path_or_uri) and, by cascade, its passages -- for a client that does not hold the note id. Both query parameters are required; scope may be the empty string, which is the root scope. Returns 404 when there is no such note for this client, and for another tenant's note alike.",
        "operationId": "deleteNoteByPath",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "description": "Scope of the note; may be empty.",
              "title": "Scope"
            },
            "description": "Scope of the note; may be empty."
          },
          {
            "name": "path_or_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Path or URI of the note within its scope.",
              "title": "Path Or Uri"
            },
            "description": "Path or URI of the note within its scope."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteNotesResponse"
                }
              }
            }
          },
          "400": {
            "description": "path_or_uri is an absolute path or contains '..'."
          },
          "401": {
            "description": "The X-API-Key header is missing, unknown or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
