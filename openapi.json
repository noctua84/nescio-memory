{
  "openapi": "3.1.0",
  "info": {
    "title": "Nescio Semantic Memory API",
    "description": "NescioAI semantic memory core.",
    "version": "0.5.0"
  },
  "paths": {
    "/api/v1/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Semantic Memory Search",
        "description": "Queries pgvector using a natural language prompt.",
        "operationId": "search_memory_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/ingest": {
      "post": {
        "tags": [
          "Ingest"
        ],
        "summary": "Ingest Markdown File",
        "description": "Chunks content, embeds via Ollama, and upserts into pgvector.",
        "operationId": "ingest_file_api_v1_ingest_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_file_api_v1_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_ingest_file_api_v1_ingest_post": {
        "properties": {
          "repo_name": {
            "type": "string",
            "title": "Repo Name",
            "description": "Repository this file belongs to."
          },
          "file_path": {
            "type": "string",
            "title": "File Path",
            "description": "Relative path of the file."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Raw markdown content to vectorize."
          }
        },
        "type": "object",
        "required": [
          "repo_name",
          "file_path",
          "content"
        ],
        "title": "Body_ingest_file_api_v1_ingest_post"
      },
      "ContextRegion": {
        "properties": {
          "repo_name": {
            "type": "string",
            "title": "Repo Name",
            "description": "Repository the region's note belongs to."
          },
          "file_path": {
            "type": "string",
            "title": "File Path",
            "description": "Relative path of the region's note."
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "The expanded text, with the chunks' shared overlap stripped at each join. Null when the stored chunks admit no safe join (see `note`)."
          },
          "chunk_index_from": {
            "type": "integer",
            "title": "Chunk Index From",
            "description": "Lowest chunk index included in this region."
          },
          "chunk_index_to": {
            "type": "integer",
            "title": "Chunk Index To",
            "description": "Highest chunk index included in this region."
          },
          "covers": {
            "type": "string",
            "title": "Covers",
            "description": "The `context` mode this region was requested under: \"neighbors\" or \"document\"."
          },
          "exact": {
            "type": "boolean",
            "title": "Exact",
            "description": "Whether this region provably reproduces the corresponding span of the original note. False means the text is best-effort and `note` says why."
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "Why the region is not exactly what was asked for -- truncated at a dropped chunk, or joined under an unverifiable window. Null when there is nothing to report."
          }
        },
        "type": "object",
        "required": [
          "repo_name",
          "file_path",
          "chunk_index_from",
          "chunk_index_to",
          "covers",
          "exact"
        ],
        "title": "ContextRegion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operation status.",
            "examples": [
              "success"
            ]
          },
          "file": {
            "type": "string",
            "title": "File",
            "description": "Path of the processed file."
          },
          "ingested": {
            "type": "integer",
            "title": "Ingested",
            "description": "Number of chunks stored."
          }
        },
        "type": "object",
        "required": [
          "status",
          "file",
          "ingested"
        ],
        "title": "IngestResponse"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "The natural language search query.",
            "examples": [
              "How do we handle API authentication across repos?"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 50,
            "minimum": 1,
            "title": "Top K",
            "description": "Max chunks to return.",
            "default": 5
          },
          "repo_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Filter",
            "description": "Optional filter by repository name.",
            "examples": [
              "repo_a"
            ]
          },
          "context": {
            "type": "string",
            "enum": [
              "none",
              "neighbors",
              "document"
            ],
            "title": "Context",
            "description": "How much surrounding text to return alongside each matched chunk. \"none\" (the default) returns matched chunks only and runs no extra query. \"neighbors\" expands each hit by `context_chunks` chunks either side. \"document\" expands to the whole note the hit came from. Expanded text is returned in the response's `contexts` list, not inline, so two hits in the same note share one region.",
            "default": "none"
          },
          "context_chunks": {
            "type": "integer",
            "maximum": 5,
            "minimum": 1,
            "title": "Context Chunks",
            "description": "Chunks to include either side of a hit. Only meaningful when `context` is \"neighbors\" -- ignored for \"none\" and \"document\".",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "contexts": {
            "items": {
              "$ref": "#/components/schemas/ContextRegion"
            },
            "type": "array",
            "title": "Contexts",
            "description": "Expanded regions referenced by the results' `context_ref`. Deduplicated and merged: two hits in the same note share one region rather than repeating its text. Empty when `context` is \"none\" or when expansion produced nothing."
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "SearchResponse"
      },
      "SearchResult": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The retrieved markdown chunk."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "File path, repo name, chunk index."
          },
          "similarity": {
            "type": "number",
            "title": "Similarity",
            "description": "Cosine similarity score (0-1)."
          },
          "context_ref": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Ref",
            "description": "Index into the response's `contexts` list of the region containing this chunk. Null when no region was built for it -- `context` was \"none\", the note's chunks could not be resolved, or the region did not fit the response's character budget."
          }
        },
        "type": "object",
        "required": [
          "content",
          "metadata",
          "similarity"
        ],
        "title": "SearchResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}