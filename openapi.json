{
  "openapi": "3.1.0",
  "info": {
    "title": "Nescio Semantic Memory API",
    "description": "NescioAI semantic memory core.",
    "version": "0.5.0"
  },
  "paths": {
    "/api/v1/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Semantic Memory Search",
        "description": "Queries pgvector using a natural language prompt.",
        "operationId": "search_memory_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/ingest": {
      "post": {
        "tags": [
          "Ingest"
        ],
        "summary": "Ingest Markdown File",
        "description": "Chunks content, embeds via Ollama, and upserts into pgvector.",
        "operationId": "ingest_file_api_v1_ingest_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_file_api_v1_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v2/search": {
      "post": {
        "tags": [
          "Search v2"
        ],
        "summary": "Keyword and phrase search over passages",
        "description": "Full-text search over note passages using websearch_to_tsquery (phrases, words, exclusions). Returns individual matching passages, never whole notes, ranked by ts_rank_cd. A query that reduces to an empty tsquery (stop words only, or pure punctuation) legitimately returns an empty result list with a 200, not an error.",
        "operationId": "searchPassagesV2",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchV2Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchV2Response"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v2/ingest": {
      "post": {
        "tags": [
          "Ingest v2"
        ],
        "summary": "Ingest a note",
        "description": "Splits Markdown content into heading-aware passages, embeds them, and upserts the note and its passages. Skips re-splitting and re-embedding when the content and pipeline version are unchanged, unless force=True.",
        "operationId": "ingestNoteV2",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestV2Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestV2Response"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v2/notes/{note_id}": {
      "get": {
        "tags": [
          "Notes v2"
        ],
        "summary": "Get a note by id",
        "description": "Fetch one note and its passage count. Returns 404 for a note that does not exist and for another tenant's note alike -- see the module docstring.",
        "operationId": "getNoteV2",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteV2Response"
                }
              }
            }
          },
          "404": {
            "description": "No such note for this client."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Notes v2"
        ],
        "summary": "Delete a note and its passages",
        "description": "Delete one note. Its passages go with it via cascade. Returns 404 for a note that does not exist and for another tenant's note alike -- see the module docstring.",
        "operationId": "deleteNoteV2",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such note for this client."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_ingest_file_api_v1_ingest_post": {
        "properties": {
          "repo_name": {
            "type": "string",
            "title": "Repo Name",
            "description": "Repository this file belongs to."
          },
          "file_path": {
            "type": "string",
            "title": "File Path",
            "description": "Relative path of the file."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Raw markdown content to vectorize."
          }
        },
        "type": "object",
        "required": [
          "repo_name",
          "file_path",
          "content"
        ],
        "title": "Body_ingest_file_api_v1_ingest_post"
      },
      "ContextRegion": {
        "properties": {
          "repo_name": {
            "type": "string",
            "title": "Repo Name",
            "description": "Repository the region's note belongs to."
          },
          "file_path": {
            "type": "string",
            "title": "File Path",
            "description": "Relative path of the region's note."
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "The expanded text, with the chunks' shared overlap stripped at each join. Null when the stored chunks admit no safe join (see `note`)."
          },
          "chunk_index_from": {
            "type": "integer",
            "title": "Chunk Index From",
            "description": "Lowest chunk index included in this region."
          },
          "chunk_index_to": {
            "type": "integer",
            "title": "Chunk Index To",
            "description": "Highest chunk index included in this region."
          },
          "covers": {
            "type": "string",
            "title": "Covers",
            "description": "The `context` mode this region was requested under: \"neighbors\" or \"document\"."
          },
          "exact": {
            "type": "boolean",
            "title": "Exact",
            "description": "Whether this region provably reproduces the corresponding span of the original note. False means the text is best-effort and `note` says why."
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "Why the region is not exactly what was asked for -- truncated at a dropped chunk, or joined under an unverifiable window. Null when there is nothing to report."
          }
        },
        "type": "object",
        "required": [
          "repo_name",
          "file_path",
          "chunk_index_from",
          "chunk_index_to",
          "covers",
          "exact"
        ],
        "title": "ContextRegion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operation status.",
            "examples": [
              "success"
            ]
          },
          "file": {
            "type": "string",
            "title": "File",
            "description": "Path of the processed file."
          },
          "ingested": {
            "type": "integer",
            "title": "Ingested",
            "description": "Number of chunks stored."
          }
        },
        "type": "object",
        "required": [
          "status",
          "file",
          "ingested"
        ],
        "title": "IngestResponse"
      },
      "IngestV2Request": {
        "properties": {
          "scope": {
            "type": "string",
            "maxLength": 512,
            "title": "Scope",
            "description": "Scope to organize notes within a tenant. Accepts both 'scope' and 'repo_name' aliases for backwards compatibility.",
            "default": "",
            "examples": [
              "project-a",
              ""
            ]
          },
          "path_or_uri": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Path Or Uri",
            "description": "Unique path or URI of the note within its scope.",
            "examples": [
              "docs/architecture/adr-001.md"
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Full markdown content of the note."
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "Optional status label for the note (e.g., 'draft', 'approved', 'superseded').",
            "examples": [
              "approved"
            ]
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta",
            "description": "Optional metadata dictionary for the note."
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "description": "Re-split, re-embed and rewrite this note's passages even when the content hash and pipeline version both match. The escape hatch for a change the pipeline version cannot see -- most plausibly a re-pulled embedding model behind an unchanged backend name and dimension.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "path_or_uri",
          "content"
        ],
        "title": "IngestV2Request",
        "description": "Request to ingest a note with passages."
      },
      "IngestV2Response": {
        "properties": {
          "note_id": {
            "type": "integer",
            "title": "Note Id",
            "description": "ID of the ingested note."
          },
          "passages": {
            "type": "integer",
            "title": "Passages",
            "description": "Number of passages now stored for this note."
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped",
            "description": "True when the skip fired (content unchanged and force=False); always False under force."
          }
        },
        "type": "object",
        "required": [
          "note_id",
          "passages",
          "skipped"
        ],
        "title": "IngestV2Response",
        "description": "Response after ingesting a note."
      },
      "NoteV2Response": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Unique identifier for the note."
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "description": "Scope to organize notes within a tenant.",
            "examples": [
              "project-a",
              ""
            ]
          },
          "path_or_uri": {
            "type": "string",
            "title": "Path Or Uri",
            "description": "Unique path or URI of the note within its scope.",
            "examples": [
              "docs/architecture/adr-001.md"
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Optional human-readable name extracted from frontmatter.",
            "examples": [
              "ADR-001: Use PostgreSQL"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Optional summary from frontmatter. Used in search at FTS weight C."
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type",
            "description": "Optional type classification from frontmatter (e.g., 'adr', 'design-doc').",
            "examples": [
              "adr"
            ]
          },
          "provenance_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provenance Kind",
            "description": "Optional provenance source kind (e.g., 'user override', 'empirical', 'agent inference').",
            "examples": [
              "user override"
            ]
          },
          "provenance_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provenance Date",
            "description": "Optional date associated with provenance."
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "Optional status label (e.g., 'approved', 'superseded').",
            "examples": [
              "approved"
            ]
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash",
            "description": "Hash of the note content, used to detect changes."
          },
          "pipeline_version": {
            "type": "string",
            "title": "Pipeline Version",
            "description": "Version identifier combining splitter, FTS composition, embedding-input composition, and embedding backend+dimension."
          },
          "body": {
            "type": "string",
            "title": "Body",
            "description": "Full markdown content of the note."
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta",
            "description": "Optional metadata dictionary."
          },
          "passage_count": {
            "type": "integer",
            "title": "Passage Count",
            "description": "Number of passages this note has been split into."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when the note was created."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Timestamp when the note was last updated."
          }
        },
        "type": "object",
        "required": [
          "id",
          "scope",
          "path_or_uri",
          "content_hash",
          "pipeline_version",
          "body",
          "meta",
          "passage_count",
          "created_at",
          "updated_at"
        ],
        "title": "NoteV2Response",
        "description": "Response containing a note and its passage count."
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "The natural language search query. Rejected with 422 if it is blank or whitespace-only after stripping; otherwise forwarded unchanged, surrounding whitespace included.",
            "examples": [
              "How do we handle API authentication across repos?"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 50,
            "minimum": 1,
            "title": "Top K",
            "description": "Max chunks to return.",
            "default": 5
          },
          "repo_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Filter",
            "description": "Optional filter by repository name.",
            "examples": [
              "repo_a"
            ]
          },
          "context": {
            "type": "string",
            "enum": [
              "none",
              "neighbors",
              "document"
            ],
            "title": "Context",
            "description": "How much surrounding text to return alongside each matched chunk. \"none\" (the default) returns matched chunks only and runs no extra query. \"neighbors\" expands each hit by `context_chunks` chunks either side. \"document\" expands to the whole note the hit came from. Expanded text is returned in the response's `contexts` list, not inline, so two hits in the same note share one region.",
            "default": "none"
          },
          "context_chunks": {
            "type": "integer",
            "maximum": 5,
            "minimum": 1,
            "title": "Context Chunks",
            "description": "Chunks to include either side of a hit. Only meaningful when `context` is \"neighbors\" -- ignored for \"none\" and \"document\".",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "contexts": {
            "items": {
              "$ref": "#/components/schemas/ContextRegion"
            },
            "type": "array",
            "title": "Contexts",
            "description": "Expanded regions referenced by the results' `context_ref`. Deduplicated and merged: two hits in the same note share one region rather than repeating its text. Empty when `context` is \"none\" or when expansion produced nothing."
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "SearchResponse"
      },
      "SearchResult": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The retrieved markdown chunk."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "File path, repo name, chunk index."
          },
          "similarity": {
            "type": "number",
            "title": "Similarity",
            "description": "Cosine similarity score (0-1)."
          },
          "context_ref": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Ref",
            "description": "Index into the response's `contexts` list of the region containing this chunk. Null when no region was built for it -- `context` was \"none\", the note's chunks could not be resolved, or the region did not fit the response's character budget."
          }
        },
        "type": "object",
        "required": [
          "content",
          "metadata",
          "similarity"
        ],
        "title": "SearchResult"
      },
      "SearchV2Request": {
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "title": "Q",
            "description": "Full-text search query. Accepts both 'q' and 'query' aliases.",
            "examples": [
              "invoice-first checkout"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 50,
            "minimum": 1,
            "title": "Top K",
            "description": "Maximum number of passages to return.",
            "default": 5
          },
          "repo_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Filter",
            "description": "Optional filter on the note's scope.",
            "examples": [
              "project-a"
            ]
          }
        },
        "type": "object",
        "required": [
          "q"
        ],
        "title": "SearchV2Request",
        "description": "Request to search notes and passages."
      },
      "SearchV2Response": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchV2Result"
            },
            "type": "array",
            "title": "Results",
            "description": "List of passages matching the search query, ordered by relevance."
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "SearchV2Response",
        "description": "Response containing search results."
      },
      "SearchV2Result": {
        "properties": {
          "passage_id": {
            "type": "integer",
            "title": "Passage Id",
            "description": "Unique identifier for the passage."
          },
          "note_id": {
            "type": "integer",
            "title": "Note Id",
            "description": "Unique identifier of the note this passage belongs to."
          },
          "ordinal": {
            "type": "integer",
            "title": "Ordinal",
            "description": "Position of this passage within the note."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Optional name of the note from frontmatter."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Optional description of the note from frontmatter. Contributes to FTS ranking at weight C."
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type",
            "description": "Optional type classification from note frontmatter."
          },
          "path_or_uri": {
            "type": "string",
            "title": "Path Or Uri",
            "description": "Unique path or URI of the note within its scope."
          },
          "heading_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading Path",
            "description": "Optional heading hierarchy path within the note.",
            "examples": [
              "Architecture \u203a API Design"
            ]
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The passage text."
          },
          "provenance_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
