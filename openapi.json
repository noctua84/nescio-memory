            "examples": [
              "invoice-first checkout"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 50,
            "minimum": 1,
            "title": "Top K",
            "description": "Number of passages to return. Hybrid search always fills up to top_k when that many passages exist (there is no relevance floor), so trailing results can be weak matches.",
            "default": 5
          },
          "repo_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
