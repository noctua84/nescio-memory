# ============================================================
# Nescio Semantic Memory API — Configuration Template
# ============================================================
# 1. Copy this file:     cp .env.example .env
# 2. Fill in your values
# 3. NEVER commit .env   (add it to .gitignore!)

# ------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# ------------------------------------------------------------
# REQUIRED. Connection string to your PostgreSQL database.
# Ensure the pgvector extension is installed:
#   CREATE EXTENSION IF NOT EXISTS vector;
# A plain postgresql:// URL uses the bundled psycopg (v3) driver.
DATABASE_URL=postgresql://user:password@localhost:5432/nescio_memory

# Connect timeout for database connections in seconds. Applies per resolved
# address in the connection string. With pool_pre_ping enabled, a dead database
# will add this timeout to the request processing time. Must be >= 2; the app
# refuses to start with smaller values since libpq silently raises any
# connect_timeout below 2 to 2 seconds.
DB_CONNECT_TIMEOUT_S=10

# Caps each statement, not the whole request. Must exceed the slowest
# legitimate search at your expected table size. Must be 1..60000 -- the app
# refuses to start otherwise. A search with context runs up to three such
# statements (the vector search, the context measurement, the context fetch),
# so the worst-case wall clock is up to three times this value. Issue #17
# (closed) added this timeout to prevent unbounded search; the ceiling
# prevents a typo (or a value above 60000) from reinstating that issue.
STATEMENT_TIMEOUT_MS=5000

# ------------------------------------------------------------
# Docker Compose only
# ------------------------------------------------------------
# REQUIRED for `docker compose`, ignored everywhere else. Password of the
# database that compose creates. Compose refuses to run while this is empty or
# unset, so fill it in; there is no default. It is placed into DATABASE_URL, so
# it must be URL-safe (letters and digits only). Generate one with:
#   openssl rand -hex 16
POSTGRES_PASSWORD=
# POSTGRES_USER and POSTGRES_DB are optional and default to nescio and
# nescio_memory.
# POSTGRES_USER=nescio
# POSTGRES_DB=nescio_memory

# ------------------------------------------------------------
# Embeddings backend
# ------------------------------------------------------------
# "ollama" (default) posts to an Ollama server over HTTP.
# "local" runs sentence-transformers in-process instead; it needs the
# optional extra, which pulls torch (~530 MB of wheels on Linux):
#   uv sync --extra local-embeddings
# Any other value fails fast at startup.
EMBEDDING_BACKEND=ollama

# Used only when EMBEDDING_BACKEND=local. 384 dimensions, which does NOT match
# the qwen3-embedding:0.6b default below (1024). The two backends are not
# interchangeable against one database: selecting "local" also means setting
# EMBEDDING_DIMENSION=384 and running the schema at revision 3d80eb22a17d
# rather than head, which is where the column is still vector(384). See the
# Embedding backends section of the README.
# Weights are fetched from Hugging Face Hub on first use.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------
# Ollama (Embedding Model)
# ------------------------------------------------------------
# URL of the Ollama batch embedding endpoint (takes `input`, returns
# `embeddings`). The legacy /api/embeddings is rejected at startup.
# Local Docker:   http://localhost:11434/api/embed
# Remote VPS:     http://<VPS_IP>:11434/api/embed
OLLAMA_URL=http://localhost:11434/api/embed

# The embedding model to use.
#   qwen3-embedding:0.6b  → 1024 dimensions (~400 MB RAM)
#   qwen3-embedding:4b    → 2560 dimensions (~2.5 GB RAM)
#   qwen3-embedding:8b    → 4096 dimensions (GPU recommended)
# Widths are the models' hidden_size; 0.6b is also confirmed against a running
# server (/api/show reports qwen3.embedding_length 1024). This list read 384
# and 1024 for the first two entries until issue #36 -- it was wrong, and the
# service could not embed anything as a result.
OLLAMA_MODEL=qwen3-embedding:0.6b

# Vector dimensionality — MUST match the model above AND the vector(N) column
# in the database. Nothing verifies it against the real model automatically;
# run `uv run python scripts/check_embedding_dimension.py` after changing it.
#   0.6b                = 1024
#   4b                  = 2560
#   8b                  = 4096
#   all-MiniLM-L6-v2    = 384   (EMBEDDING_BACKEND=local only)
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------
# Search and query embedding (all optional; defaults shown)
# ------------------------------------------------------------
# Candidates each search arm (vector, full-text) contributes to rank fusion.
# Must be in 1..1000.
# SEARCH_CANDIDATES=50

# Reciprocal Rank Fusion damping constant. Must be >= 1.
# RRF_K=60

# Per-arm multipliers on the fused score. Each must be finite and >= 0; 0
# switches that arm off, but they must not both be 0.
# FTS_WEIGHT=1.0
# VECTOR_WEIGHT=1.0

# Prefix put on search queries (never on passages) for instruction-tuned
# embedding models such as Qwen3-Embedding. Set to an empty string to disable.
# QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Seconds to wait for the query embedding before search degrades. 0 < x <= 30.
# The default covers Ollama reloading a model it unloaded after its keep_alive
# (5 minutes idle by default); to avoid the reload, set OLLAMA_KEEP_ALIVE on the
# Ollama server.
# QUERY_EMBED_TIMEOUT_S=15

# Texts per embedding request during ingest. Must be in 1..256.
# EMBED_BATCH_SIZE=16

# GET /ready: seconds to wait for each dependency check before reporting it as
# "timeout". 0 < x <= 10. The two checks run in parallel, so the endpoint answers
# within the larger of the two.
# READY_DB_TIMEOUT_S=2.0
# READY_EMBEDDING_TIMEOUT_S=2.0

# GET /ready: seconds a finished result is reused so frequent probes do not each
# hit the database and Ollama. 0 <= x <= 60; 0 disables reuse (a check already
# running is still shared).
# READY_CACHE_TTL_S=5.0

# Retry of transient embedding failures (timeouts, connection errors, HTTP
# 408/429/500/502/503/504). Bad responses and misconfiguration are never retried.
# Tries per batch, the first included; 1 means no retry. 1..5.
# EMBED_RETRY_ATTEMPTS=3
# Backoff before the first retry, doubling each time, with full jitter.
# 0 < x <= EMBED_RETRY_MAX_DELAY_S.
# EMBED_RETRY_BASE_DELAY_S=0.5
# Longest single backoff, and the cap on a server's Retry-After. 0 < x <= 10.
# EMBED_RETRY_MAX_DELAY_S=4.0
# Retries shared by ALL batches of one ingest request; 0 disables retry. 0..10.
# Ingest holds a row lock while embedding, so this bounds the extra hold at
# EMBED_RETRY_BUDGET * (30 s + EMBED_RETRY_MAX_DELAY_S).
# EMBED_RETRY_BUDGET=2

# ------------------------------------------------------------
# Audit trail (all optional; defaults shown)
# ------------------------------------------------------------
# api_keys.last_used_at is rewritten at most once per this many seconds per key.
# 0 touches on every request. Must be in 0..86400.
# KEY_LAST_USED_THROTTLE_S=300

# Days ingest_events rows are kept by scripts/prune_ingest_events.py.
# Must be in 30..3650.
# AUDIT_RETENTION_DAYS=400

# ------------------------------------------------------------
# Per-client rate limits (all optional; defaults shown)
# ------------------------------------------------------------
# There is no off switch; raise a limit instead. They hold across replicas.
# Ingests that may embed at once, per client. Skipped re-ingests do not count.
# Must be in 1..32.
# RATE_LIMIT_INGEST_CONCURRENCY=2

# Retry-After, in seconds, on an ingest refused for want of a slot. A hint: a slot
# is held for the whole embedding, retries included. Must be in 1..60.
# RATE_LIMIT_INGEST_RETRY_AFTER_S=5

# Searches per client per window. Must be in 1..10000.
# RATE_LIMIT_SEARCH_REQUESTS=120

# Length of the fixed search window, in seconds. Must be in 1..3600.
# RATE_LIMIT_WINDOW_S=60

# ------------------------------------------------------------
# Langfuse (Observability & Tracing)
# ------------------------------------------------------------
# OPTIONAL. Leave empty to disable tracing.
# Get keys from: https://cloud.langfuse.com/project/<id>/settings/api-keys
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Display name in the OpenAPI documentation
APP_NAME='Nescio Semantic Memory API'

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# json = one OpenTelemetry-shaped JSON object per line on stdout (default, for a
# collector such as Dash0's filelog receiver); text = readable lines for a local
# terminal. Any other value fails at startup. See the Logging section of the README.
LOG_FORMAT=json

# Service identity stamped on every log line. These two are read from the
# PROCESS environment only (like LANGFUSE_*), not from this file, so they are
# shown commented out: export them in the shell or container instead.
#   OTEL_SERVICE_NAME=nescio-memory
#   OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod,service.version=1.2.3

# ------------------------------------------------------------
# Server (used when running via uvicorn)
# ------------------------------------------------------------
# 0.0.0.0 = accept external connections (Docker / K8s)
# 127.0.0.1 = local access only
HOST=0.0.0.0

# Port to listen on
PORT=8000