# ============================================================
# Nescio Semantic Memory API — Configuration Template
# ============================================================
# 1. Copy this file:     cp .env.example .env
# 2. Fill in your values
# 3. NEVER commit .env   (add it to .gitignore!)

# ------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# ------------------------------------------------------------
# REQUIRED. Connection string to your PostgreSQL database.
# Ensure the pgvector extension is installed:
#   CREATE EXTENSION IF NOT EXISTS vector;
# A plain postgresql:// URL uses the bundled psycopg (v3) driver.
DATABASE_URL=postgresql://user:password@localhost:5432/nescio_memory

# Caps the search statement only (not the whole request). Must exceed the
# slowest legitimate search at your expected table size, and must be > 0 --
# the app refuses to start otherwise, since 0 would disable the timeout.
STATEMENT_TIMEOUT_MS=5000

# ------------------------------------------------------------
# Embeddings backend
# ------------------------------------------------------------
# "ollama" (default) posts to an Ollama server over HTTP.
# "local" runs sentence-transformers in-process instead; it needs the
# optional extra, which pulls torch (~530 MB of wheels on Linux):
#   uv sync --extra local-embeddings
# Any other value fails fast at startup.
EMBEDDING_BACKEND=ollama

# Used only when EMBEDDING_BACKEND=local. 384 dimensions, which does NOT match
# the qwen3-embedding:0.6b default below (1024). The two backends are not
# interchangeable against one database: selecting "local" also means setting
# EMBEDDING_DIMENSION=384 and running the schema at revision 3d80eb22a17d
# rather than head, which is where the column is still vector(384). See the
# Embedding backends section of the README.
# Weights are fetched from Hugging Face Hub on first use.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------
# Ollama (Embedding Model)
# ------------------------------------------------------------
# URL of the Ollama embedding API endpoint.
# Local Docker:   http://localhost:11434/api/embeddings
# Remote VPS:     http://<VPS_IP>:11434/api/embeddings
OLLAMA_URL=http://localhost:11434/api/embeddings

# The embedding model to use.
#   qwen3-embedding:0.6b  → 1024 dimensions (~400 MB RAM)
#   qwen3-embedding:4b    → 2560 dimensions (~2.5 GB RAM)
#   qwen3-embedding:8b    → 4096 dimensions (GPU recommended)
# Widths are the models' hidden_size; 0.6b is also confirmed against a running
# server (/api/show reports qwen3.embedding_length 1024). This list read 384
# and 1024 for the first two entries until issue #36 -- it was wrong, and the
# service could not embed anything as a result.
OLLAMA_MODEL=qwen3-embedding:0.6b

# Vector dimensionality — MUST match the model above AND the vector(N) column
# in the database. Nothing verifies it against the real model automatically;
# run `uv run python scripts/check_embedding_dimension.py` after changing it.
#   0.6b                = 1024
#   4b                  = 2560
#   8b                  = 4096
#   all-MiniLM-L6-v2    = 384   (EMBEDDING_BACKEND=local only)
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------
# Langfuse (Observability & Tracing)
# ------------------------------------------------------------
# OPTIONAL. Leave empty to disable tracing.
# Get keys from: https://cloud.langfuse.com/project/<id>/settings/api-keys
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Display name in the OpenAPI documentation
APP_NAME='Nescio Semantic Memory API'

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Chunking Strategy (used during /ingest)
# ------------------------------------------------------------
# Maximum characters per chunk
CHUNK_SIZE=1000

# Overlap between consecutive chunks (preserves context at boundaries).
# Must satisfy 0 <= CHUNK_OVERLAP < CHUNK_SIZE, otherwise the app refuses to
# start: a step of zero or less leaves the sliding window spinning forever.
CHUNK_OVERLAP=200

# ------------------------------------------------------------
# Context expansion (used during /search)
# ------------------------------------------------------------
# Total characters of expanded context one search response may carry, across
# all regions. Regions are built in descending order of the best similarity
# among the results referencing them and stop once this would be exceeded, so
# it is a cap rather than a target. Must be > 0, otherwise the app refuses to
# start: 0 does not shrink the budget, it silently returns no context at all
# for requests that asked for some.
MAX_CONTEXT_CHARS=100000

# ------------------------------------------------------------
# Server (used when running via uvicorn)
# ------------------------------------------------------------
# 0.0.0.0 = accept external connections (Docker / K8s)
# 127.0.0.1 = local access only
HOST=0.0.0.0

# Port to listen on
PORT=8000