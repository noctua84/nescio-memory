# Nightly backup, then a restore of what was just uploaded, then the heartbeat.
#
# Each ExecStart runs only if the one before it succeeded, so a failed backup
# never reaches the restore check, and the restore check never pings for a
# backup older than tonight's. The ping is the last thing to happen: silence at
# the dead-man's switch is the alert. See "Backup and recovery" in the README.
#
# Assumes a checkout at /opt/nescio-memory with `uv sync --locked --no-dev` run
# in it; postgresql-client-17 and rclone on the host; and the environment in
# /etc/nescio/backup.env (0600, root-owned), including
# RCLONE_CONFIG=/etc/nescio/rclone.conf.
[Unit]
Description=Nescio memory: back up, restore-check, heartbeat
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=nescio-backup
Group=nescio-backup
WorkingDirectory=/opt/nescio-memory
EnvironmentFile=/etc/nescio/backup.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nescio-memory/.venv/bin/python -m scripts.backup
ExecStart=/opt/nescio-memory/.venv/bin/python -m scripts.restore_check --scheduled

# A oneshot has no start timeout by default, and a run that hangs would then hold
# this unit active and stop the timer's next run. Killing it is safe: the next
# run replaces the scratch database and the work directory. Raise this if a
# restore's measured time approaches it.
TimeoutStartSec=6h

# /var/lib/nescio-backup, created and owned for this user: BACKUP_SPOOL_DIR's default.
StateDirectory=nescio-backup
StateDirectoryMode=0700
# The dumps hold personal notes.
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
