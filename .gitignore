# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
.venv/
venv/
.env

# IDE
.idea/
.vscode/

# AI agent tooling - machine-local settings only.
# QWEN.md at the repo root stays tracked: it is shared project context.
.qwen/settings.json

# Plan-execution scratch (agent briefs/reports) - see docs/superpowers/README.md
.superpowers/

# Retrieval evaluation harness (eval/) - PRIVACY BOUNDARY, NOT CONVENIENCE.
#
# This repository is public. The real brain the harness is pointed at with
# --corpus contains third-party client project names and internal detail, so
# nothing derived from it may ever land in git: not a report, not a JSON
# record, not a query set whose text quotes a note.
#
# eval/corpora/synthetic/ stays tracked -- it is the committed fixture corpus
# that makes the harness reviewable by anyone. Only real-corpus material is
# excluded here.
eval-out/
eval/private/
eval/corpora/real/
eval/**/*.local.yaml

# OS
.DS_Store
Thumbs.db

# NOTE: uv.lock is intentionally NOT ignored - it pins all 85 packages
# with hashes and is what guarantees dev/CI/prod install identically.
